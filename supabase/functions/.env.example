# `supabase secrets set --env-file supabase/functions/.env` (never commit the real file)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Comma-separated origins allowed to call the functions from a browser.
ALLOWED_ORIGINS=http://localhost:3000,https://<user>.github.io
# Where Stripe sends the customer back. Must be one of the origins above.
SITE_URL=http://localhost:3000
# "/kicks" on GitHub Pages project sites, empty otherwise.
SITE_BASE_PATH=
