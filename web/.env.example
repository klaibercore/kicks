# Copy to .env.local for development. Every variable here ships to the browser
# (NEXT_PUBLIC_ prefix) — never put a secret in this file.

# The kicks REST API (`kicks serve`). No trailing slash.
NEXT_PUBLIC_KICKS_API_URL=http://localhost:8080

# Supabase project (Project Settings -> API). The anon key is public by design;
# row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Web Analytics site token. Loaded only after the visitor consents.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# "/kicks" when hosted at <user>.github.io/kicks/, empty on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Operator details for the Impressum / Datenschutzerklärung. Required by
# § 5 DDG before the site goes public; the pages show placeholders until set.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_VAT_ID=
